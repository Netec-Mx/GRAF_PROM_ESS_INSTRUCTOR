      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "p95 por servicio en prod",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
