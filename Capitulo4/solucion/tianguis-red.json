                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_request_duration_seconds_bucket{ambiente!=\"dev\", http_route!=\"/salud\"}[5m])))",
                        "legendFormat": "__auto",
                        "range": true
