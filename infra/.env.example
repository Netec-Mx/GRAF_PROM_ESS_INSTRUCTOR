# Plantilla de variables del stack. Se commitea.
# bin/up.sh la copia a infra/.env la primera vez. Edita infra/.env, no este archivo.

# Nombre fijo del proyecto de Compose. No cambiar.
COMPOSE_PROJECT_NAME=gpe

# ---------------------------------------------------------------------------
# Versiones (tag exacto de cada imagen, prohibido latest)
# ---------------------------------------------------------------------------
PROMETHEUS_VERSION=v3.13.4
ALERTMANAGER_VERSION=v0.34.1
GRAFANA_VERSION=13.2.3
LOKI_VERSION=3.7.8
ALLOY_VERSION=v1.20.1
OTELCOL_VERSION=0.161.0
TEMPO_VERSION=3.1.0
NODE_EXPORTER_VERSION=v1.12.1
PUSHGATEWAY_VERSION=v1.11.4
MAILPIT_VERSION=v1.31.5
# Imagen base y uv con los que se construye el servicio catalogo.
PYTHON_VERSION=3.14.8
UV_VERSION=0.13.0
# Imagen de Go con la que se compila el servicio pedidos y digest de su imagen final
# (gcr.io/distroless/static-debian13:nonroot, que no publica tags con versión).
GO_VERSION=1.27.2
DISTROLESS_DIGEST=sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
# Imagen de Java (Eclipse Temurin) del servicio pagos, y agente de OpenTelemetry que se le
# adjunta. El Dockerfile descarga el agente desde su release de GitHub y exige este SHA-256.
JAVA_VERSION=25.0.4.1_1
OTEL_AGENT_VERSION=2.32.0
OTEL_AGENT_SHA256=f787eb6c7f3d18e69a431e108a15278d25ee37f83d68b678f621e063f3988f82
# Grafana k6, la clientela de la tienda. Se usa la línea 1.x: la 2.x eliminó el executor
# externally-controlled y los comandos k6 scale, pause y resume, que son los que permiten
# cambiar el tráfico en vivo.
K6_VERSION=1.8.2
# Solo aporta el binario de wget para los healthchecks de imágenes sin shell.
BUSYBOX_VERSION=1.37.0-musl

# ---------------------------------------------------------------------------
# Credenciales por defecto (solo para el laboratorio local)
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=tianguis

# ---------------------------------------------------------------------------
# Puertos en el host. Todos escuchan solo en 127.0.0.1.
# Si alguno está ocupado en tu máquina, cámbialo aquí. Nunca uses 5432 ni 8081.
# ---------------------------------------------------------------------------
PUERTO_GRAFANA=3000
PUERTO_PROMETHEUS=9090
PUERTO_ALERTMANAGER=9093
PUERTO_PUSHGATEWAY=9091
PUERTO_NODE_EXPORTER=9100
PUERTO_LOKI=3100
PUERTO_TEMPO=3200
PUERTO_ALLOY=12345
PUERTO_OTLP_GRPC=4317
PUERTO_OTLP_HTTP=4318
PUERTO_MAILPIT_UI=8025
PUERTO_MAILPIT_SMTP=1025
PUERTO_CATALOGO=8001
PUERTO_PEDIDOS=8002
PUERTO_PAGOS=8003
# Ambiente dev.
PUERTO_CATALOGO_DEV=8011
PUERTO_PEDIDOS_DEV=8012

# ---------------------------------------------------------------------------
# Job de conciliación
# ---------------------------------------------------------------------------
# Segundos entre una corrida y la siguiente.
CONCILIACION_INTERVALO=300
# Ventana que se concilia: los pedidos creados entre hace CONCILIACION_VENTANA_S segundos y
# hace CONCILIACION_GRACIA_S segundos. La gracia deja fuera a los pedidos que el cliente
# todavía está pagando. La ventana deja fuera a los pedidos tan viejos que su pago pudo haber
# salido ya de la memoria de pagos, que solo guarda los últimos 1000.
CONCILIACION_VENTANA_S=900
CONCILIACION_GRACIA_S=60

# ---------------------------------------------------------------------------
# Caos
# ---------------------------------------------------------------------------
# Token que piden las rutas /caos de catalogo, pedidos y pagos, en la cabecera X-Caos-Token.
# bin/caos.sh lo lee de aquí. Es un token de curso, no un secreto: el stack solo escucha en
# 127.0.0.1. Si lo dejas vacío, el caos queda deshabilitado en los cuatro componentes.
CAOS_TOKEN=tianguis-caos
