            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Servicios",
              "collapse": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 3,
                  "columnWidthMode": "standard",
                  "rowHeightMode": "standard",
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-1"
                        },
                        "repeat": {
                          "mode": "variable",
                          "value": "servicio"
                        }
                      }
                    }
                  ]
                }
