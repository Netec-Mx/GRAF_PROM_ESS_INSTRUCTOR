    "title": "Tianguis · Multiambiente",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "ambiente",
          "current": {
            "text": "prod",
            "value": "prod"
          },
          "hide": "dontHide",
          "refresh": "onDashboardLoad",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "prometheus"
            },
            "spec": {
              "qryType": 5,
              "query": "label_values(http_server_requests_total, ambiente)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          },
          "regex": "",
          "regexApplyTo": "value",
          "sort": "disabled",
          "definition": "label_values(http_server_requests_total, ambiente)",
          "options": [],
          "multi": false,
          "includeAll": false,
          "allowCustomValue": true
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "servicio",
          "current": {
            "text": [
              "catalogo"
            ],
            "value": [
              "catalogo"
            ]
          },
          "hide": "dontHide",
          "refresh": "onDashboardLoad",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "prometheus"
            },
            "spec": {
              "qryType": 5,
              "query": "query_result(count by (job) (label_replace(http_server_request_duration_seconds_count, \"ambiente\", \"prod\", \"ambiente\", \"\") and on(ambiente) label_replace(vector(1), \"ambiente\", \"$ambiente\", \"\", \"\")))",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          },
          "regex": "/job=\"([^\"]+)\"/",
          "regexApplyTo": "value",
          "sort": "disabled",
          "definition": "query_result(count by (job) (label_replace(http_server_request_duration_seconds_count, \"ambiente\", \"prod\", \"ambiente\", \"\") and on(ambiente) label_replace(vector(1), \"ambiente\", \"$ambiente\", \"\", \"\")))",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allowCustomValue": true
        }
      },
      {
        "kind": "IntervalVariable",
        "spec": {
          "name": "intervalo",
          "query": "1m,5m,15m",
          "current": {
            "text": "1m",
            "value": "1m"
          },
          "options": [
            {
              "selected": true,
              "text": "1m",
              "value": "1m"
            },
            {
              "selected": false,
              "text": "5m",
              "value": "5m"
            },
            {
              "selected": false,
              "text": "15m",
              "value": "15m"
            }
          ],
          "auto": false,
          "auto_min": "10s",
          "auto_count": 30,
          "refresh": "onTimeRangeChanged",
          "hide": "dontHide",
          "skipUrlSync": false
        }
      },
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "umbral",
          "query": "0.01,0.05,0.10",
          "current": {
            "text": "0.01",
            "value": "0.01"
